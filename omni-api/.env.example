PORT=8080
# 逗號分隔；填 * 表示全開（正式環境請改白名單）
CORS_ORIGINS=*

# WebSocket 來源白名單（/asr 用），正式環境務必填網域
WS_ALLOWED_ORIGINS=*

# DashScope ASR
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
# 國際版改成 wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
WS_IDLE_TIMEOUT_SEC=120
WS_HEARTBEAT_SEC=30

# 之後搬路由時陸續加入
# AZURE_KEY=
# AZURE_REGION=eastasia
# DIFY_OMNI_KEY=
# ELEVENLABS_KEY=
